# Base image for the ephemeral sandbox (WSC-E1-T1 + WSC-E3-T4b).
#
# Phase 1: `python:3.11-slim` ships no `git` -- it is needed both by the Coder
# and by the checkpoint pre-receive hook (invoked on the side that RECEIVES the
# `git push`, which runs inside this same container whenever "origin" is a
# bind-mounted bare repo).
#
# Phase 3 (WSC-E3-T4b, addendum 02): a REAL Playwright toolchain for the `@demo`
# evidence -- node + a pinned @playwright/test (P7 boring-first) + headless
# chromium with its system dependencies (`--with-deps`). The WS-E evidence
# pipeline runs `npx playwright test --grep @demo` INSIDE a container of this
# image, and the video it produces is real.
#
# Decisions behind this image (all of them so it works under the restrictions
# docker_driver.py imposes: `--user <random non-root uid>`, `--read-only`,
# `--cap-drop ALL`, `--tmpfs /tmp`, internal network with no internet):
#   - Browsers under PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers (outside $HOME --
#     the runtime uid does not exist in /etc/passwd and the rootfs is read-only);
#     `chmod a+rX` so any uid can execute them.
#   - @playwright/test installed under /opt/dse-playwright (world-readable
#     node_modules); NODE_PATH + PATH point there, so `npx playwright` resolves
#     without installing anything at runtime (there is no network in the sandbox
#     anyway -- a runtime download would not even be possible).
#   - HOME=/tmp: chromium/crashpad need a writable directory; /tmp is the
#     sandbox's ephemeral tmpfs.
#   - chromium's own sandbox (user namespaces) does not work under
#     `--cap-drop ALL`; the fixture's playwright.config sets
#     `chromiumSandbox: false` -- containment comes from the container
#     (rootless, read-only, no network), not from the browser.
#
# Creates no fixed user in the image: the non-root uid/gid is applied at runtime
# via `docker run --user <uid>:<gid>` (docker_driver.py), so any numeric uid
# works without having to exist in /etc/passwd (git reads name/email from the
# repo-local config only, never from a passwd lookup -- see
# scoped_git.ScopedGitSession.ensure_identity).
#
# Build + tag (documented in the README; the acceptance tests build it if the
# tag is missing):
#   docker build -f services/sandbox-runtime/docker/Dockerfile.sandbox-base \
#     -t dse-sandbox-base:wsc3 services/sandbox-runtime/docker
#
# Base pinned to -bookworm (P7): the `python:3.11-slim` tag moved to Debian
# trixie, which `playwright install --with-deps` does not recognise (the
# ubuntu20.04 fallback then fails on renamed font packages -- a real failure
# observed while building this image). Bookworm (Debian 12) is supported by
# Playwright.
FROM python:3.11-slim-bookworm

# Toolchain pin (P7): node/npm come from Debian bookworm's apt (nodejs 18.x,
# enough for Playwright >= 1.49); the Playwright version is pinned exactly below
# and has to match the one the installed browsers were built for.
ARG PLAYWRIGHT_VERSION=1.49.1

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates nodejs npm \
    && rm -rf /var/lib/apt/lists/*

ENV PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers \
    NODE_PATH=/opt/dse-playwright/node_modules \
    PATH=/opt/dse-playwright/node_modules/.bin:$PATH \
    HOME=/tmp

WORKDIR /opt/dse-playwright
RUN npm init -y >/dev/null \
    && npm install --no-audit --no-fund "@playwright/test@${PLAYWRIGHT_VERSION}" "playwright@${PLAYWRIGHT_VERSION}" \
    && npx playwright install --with-deps chromium \
    && chmod -R a+rX /opt/dse-playwright /opt/pw-browsers \
    # `npx <pkg>` (npm >= 9) does NOT consult $PATH -- it resolves through the
    # "local prefix" (walking node_modules up from the cwd) and, finding
    # nothing, tries to INSTALL from the registry (impossible and unwanted in a
    # sandbox with no internet -- a real failure observed here). The symlink at
    # the root makes any container cwd (e.g. /workspace/demos/<wi>) resolve the
    # image's pinned toolchain, so `npx playwright test --grep @demo` works
    # offline, which is the T4b acceptance criterion.
    && ln -s /opt/dse-playwright/node_modules /node_modules

WORKDIR /workspace
