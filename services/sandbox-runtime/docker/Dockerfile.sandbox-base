# Imagem base do sandbox efêmero (WSC-E1-T1 + WSC-E3-T4b).
#
# Fase 1: `python:3.11-slim` não traz `git` — precisamos dele tanto para o
# Coder quanto para o hook pre-receive do checkpoint (invocado no lado que
# recebe o `git push`, que roda dentro deste mesmo container quando o
# "origin" é um bare repo bind-mounted).
#
# Fase 3 (WSC-E3-T4b, adendo 02): toolchain Playwright REAL para a evidência
# `@demo` — node + @playwright/test pinado (P7 boring-first) + browser
# chromium headless com dependências de sistema (`--with-deps`). O pipeline
# de evidência do WS-E executa `npx playwright test --grep @demo` DENTRO de
# um container desta imagem e o vídeo produzido é real.
#
# Decisões desta imagem (todas para funcionar sob as restrições do
# docker_driver.py: `--user <uid aleatório não-root>`, `--read-only`,
# `--cap-drop ALL`, `--tmpfs /tmp`, rede interna sem internet):
#   - Browsers em PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers (fora de $HOME —
#     o uid de runtime não existe em /etc/passwd e o rootfs é read-only);
#     `chmod a+rX` para qualquer uid poder executar.
#   - @playwright/test instalado em /opt/dse-playwright (node_modules
#     world-readable); NODE_PATH + PATH apontam para lá, então `npx
#     playwright` resolve sem instalar nada em runtime (não há rede no
#     sandbox de qualquer forma — download em runtime nem seria possível).
#   - HOME=/tmp: chromium/crashpad precisam de um diretório gravável; /tmp é
#     o tmpfs efêmero do sandbox.
#   - O sandbox do próprio chromium (user namespaces) não funciona com
#     `--cap-drop ALL`; o playwright.config do fixture usa
#     `chromiumSandbox: false` — a contenção é do container (rootless,
#     read-only, sem rede), não do browser.
#
# Não cria usuário fixo na imagem: o uid/gid não-root é aplicado em runtime
# via `docker run --user <uid>:<gid>` (docker_driver.py), então qualquer uid
# numérico funciona sem precisar existir em /etc/passwd (git usa apenas
# config local do repo, nunca lookup de passwd, para name/email — ver
# scoped_git.ScopedGitSession.ensure_identity).
#
# Build + tag (documentado no README; os testes de aceitação buildam se a
# tag não existir):
#   docker build -f services/sandbox-runtime/docker/Dockerfile.sandbox-base \
#     -t dse-sandbox-base:wsc3 services/sandbox-runtime/docker
#
# Pin da base em -bookworm (P7): a tag `python:3.11-slim` migrou para Debian
# trixie, que o `playwright install --with-deps` não reconhece (o fallback
# ubuntu20.04 falha em pacotes de fonte renomeados — falha real observada no
# build desta sessão). Bookworm (Debian 12) é suportado pelo Playwright.
FROM python:3.11-slim-bookworm

# Pin do toolchain (P7): node/npm vêm do apt do Debian bookworm (nodejs 18.x,
# suficiente para Playwright >= 1.49); a versão do Playwright é pinada
# exatamente abaixo e tem que bater com a dos browsers instalados.
ARG PLAYWRIGHT_VERSION=1.49.1

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates nodejs npm \
    && rm -rf /var/lib/apt/lists/*

ENV PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers \
    NODE_PATH=/opt/dse-playwright/node_modules \
    PATH=/opt/dse-playwright/node_modules/.bin:$PATH \
    HOME=/tmp

WORKDIR /opt/dse-playwright
RUN npm init -y >/dev/null \
    && npm install --no-audit --no-fund "@playwright/test@${PLAYWRIGHT_VERSION}" "playwright@${PLAYWRIGHT_VERSION}" \
    && npx playwright install --with-deps chromium \
    && chmod -R a+rX /opt/dse-playwright /opt/pw-browsers \
    # `npx <pkg>` (npm >= 9) NÃO consulta o $PATH — resolve pelo "local
    # prefix" (walk-up de node_modules a partir do cwd) e, não achando,
    # tenta INSTALAR do registry (impossível e indesejado no sandbox sem
    # internet — falha real observada nesta sessão). O symlink na raiz faz
    # qualquer cwd do container (ex.: /workspace/demos/<wi>) resolver a
    # toolchain pinada da imagem: `npx playwright test --grep @demo`
    # funciona offline, que é o aceite do T4b.
    && ln -s /opt/dse-playwright/node_modules /node_modules

WORKDIR /workspace
