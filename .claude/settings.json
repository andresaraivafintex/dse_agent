{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/verify-edit.sh\"",
            "timeout": 60,
            "statusMessage": "Verificando o arquivo editado..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/gate-stop.sh\"",
            "timeout": 300,
            "statusMessage": "Lint e suites sem docker antes de encerrar..."
          }
        ]
      }
    ]
  }
}
